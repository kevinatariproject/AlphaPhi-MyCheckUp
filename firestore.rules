rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isAdmin() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // Admins
    match /admins/{uid} {
      allow read: if false;
      allow write: if isAdmin();
    }

    // Departments
    match /departments/{deptId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // Patients
    match /patients/{patientId} {
      allow create: if isSignedIn() && isOwner(request.resource.id);
      allow read, update: if isOwner(patientId) || isAdmin();
      allow delete: if isAdmin();

      match /guardians/{guardianId} {
        allow read: if isOwner(patientId) || isAdmin() ||
                    (isSignedIn() && request.auth.uid == guardianId);

        allow create: if (isSignedIn() && request.auth.uid == guardianId) || isAdmin();

        allow update, delete: if isAdmin();
      }
    }

    // Guardians
    match /guardians/{guardianId} {
      allow create: if isSignedIn() && isOwner(request.resource.id);
      allow read, update: if isOwner(guardianId) || isAdmin();
      allow delete: if isAdmin();
    }

    // Doctors
    match /doctors/{doctorId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isOwner(request.resource.id);
      allow update: if isOwner(doctorId) || isAdmin();
      allow delete: if isAdmin();

      match /availability/{slotId} {
        allow read: if isSignedIn();
        allow create, update, delete: if isOwner(doctorId) || isAdmin();
      }
    }

    // Appointments
    match /appointments/{apptId} {
      allow create: if isSignedIn()
                    && request.resource.data.patientId == request.auth.uid
                    || (isSignedIn()
                        && exists(/databases/$(database)/documents/patients/$(request.resource.data.patientId)/guardians/$(request.auth.uid)))
                    || isAdmin();

      allow read: if isAdmin()
                  || (isSignedIn() && resource.data.patientId == request.auth.uid)
                  || (isSignedIn()
                      && exists(/databases/$(database)/documents/patients/$(resource.data.patientId)/guardians/$(request.auth.uid)))
                  || (isSignedIn() && resource.data.doctorId == request.auth.uid);

      allow update: if isAdmin()
                    || (isSignedIn() && resource.data.patientId == request.auth.uid)
                    || (isSignedIn()
                        && exists(/databases/$(database)/documents/patients/$(resource.data.patientId)/guardians/$(request.auth.uid)))
                    || (isSignedIn() && resource.data.doctorId == request.auth.uid);

      allow delete: if isAdmin();
    }

    // Reports
    match /reports/{reportId} {
      allow create: if isSignedIn()
                    && request.resource.data.doctorId == request.auth.uid;

      allow read: if isAdmin()
                  || (isSignedIn() && resource.data.patientId == request.auth.uid)
                  || (isSignedIn()
                      && exists(/databases/$(database)/documents/patients/$(resource.data.patientId)/guardians/$(request.auth.uid)))
                  || (isSignedIn() && resource.data.doctorId == request.auth.uid);

      allow update: if (isSignedIn() && resource.data.doctorId == request.auth.uid) || isAdmin();
      allow delete: if isAdmin();
    }

  }
}
