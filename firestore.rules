rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isGuardian(patientId) {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/guardians/$(request.auth.uid)/patients/$(patientId)) &&
        exists(/databases/$(database)/documents/patients/$(patientId)/guardians/$(request.auth.uid));
    }

    function isAdmin() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // Check if auth user is the patient OR the guardian of that patient
    function isPatientOrGuardian(patientId) {
      return isOwner(patientId) || isGuardian(patientId);
    }

    function appointmentDoc(appointmentId) {
      return get(/databases/$(database)/documents/appointments/$(appointmentId));
    }

    // Block creation must match appointment exactly
    function canCreateBlock(doctorId, appointmentId) {
      return exists(/databases/$(database)/documents/appointments/$(appointmentId))
        && isPatientOrGuardian(appointmentDoc(appointmentId).data.patientId)
        && appointmentDoc(appointmentId).data.doctorId == doctorId
        && request.resource.data.keys().hasOnly(['startTime', 'endTime'])
        && request.resource.data.startTime == appointmentDoc(appointmentId).data.startTime
        && request.resource.data.endTime == appointmentDoc(appointmentId).data.endTime
        && appointmentDoc(appointmentId).data.status == "scheduled";
    }

    // Block updating must match appointment exactly
    function canUpdateBlock(doctorId, appointmentId) {
      return exists(/databases/$(database)/documents/appointments/$(appointmentId))
        && isPatientOrGuardian(appointmentDoc(appointmentId).data.patientId)
        && appointmentDoc(appointmentId).data.doctorId == doctorId
        && request.resource.data.keys().hasOnly(['startTime', 'endTime'])
        && request.resource.data.startTime == appointmentDoc(appointmentId).data.startTime
        && request.resource.data.endTime == appointmentDoc(appointmentId).data.endTime
        && appointmentDoc(appointmentId).data.status == "rescheduled";
    }

    // Block deletion only allowed after cancellation
    function canDeleteBlock(doctorId, appointmentId) {
      return exists(/databases/$(database)/documents/appointments/$(appointmentId))
        && isPatientOrGuardian(appointmentDoc(appointmentId).data.patientId)
        && appointmentDoc(appointmentId).data.doctorId == doctorId
        && appointmentDoc(appointmentId).data.status == "cancelled";
    }

    // Admins
    match /admins/{uid} {
      allow read, write: if isAdmin();
    }

    // Departments
    match /departments/{deptId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // Usernames
    match /usernames/{username} {
      allow read: if true;
      allow create: if isAdmin()
                    || (isSignedIn() && !exists(/databases/$(database)/documents/usernames/$(username)));
      allow delete: if isOwner(resource.data.userId) || isAdmin();
    }

    // Patients
    match /patients/{patientId} {
      allow create: if isOwner(patientId) || exists(/databases/$(database)/documents/guardians/$(request.auth.uid));
      allow read: if isPatientOrGuardian(patientId)
            || isAdmin()
            || (isSignedIn() &&
                exists(/databases/$(database)/documents/doctors/$(request.auth.uid)));
      
      allow update, delete: if isPatientOrGuardian(patientId) || isAdmin();
      

      match /guardians/{guardianId} {
        allow read, write: if isAdmin();
        allow read: if isOwner(patientId)
                    || isOwner(guardianId)
                    || (isSignedIn() && exists(/databases/$(database)/documents/doctors/$(request.auth.uid)));
        allow update, delete: if isOwner(guardianId);
        allow create: if exists(/databases/$(database)/documents/guardians/$(guardianId)/patients/$(patientId));
      }
    }

    // Guardians
    match /guardians/{guardianId} {
      allow create: if isSignedIn() && isOwner(request.resource.id);
      allow read, update: if isOwner(guardianId) || isAdmin();
      allow delete: if isAdmin();

      match /patients/{patientId} {
        allow read, write: if isOwner(guardianId) || isAdmin();
      }
    }

    // Doctors
    match /doctors/{doctorId} {
      allow read: if isSignedIn();
      allow create, update: if isOwner(doctorId) || isAdmin();
      allow delete: if isAdmin();
    }

    // Schedules
    match /schedules/{doctorId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isAdmin();

      match /blocks/{appointmentId} {
        allow read: if isSignedIn();
        allow create: if isAdmin() || canCreateBlock(doctorId, appointmentId);
        allow update: if isAdmin() || canUpdateBlock(doctorId, appointmentId);
        allow delete: if isAdmin() || canDeleteBlock(doctorId, appointmentId);
      }
    }

    // Appointments
    match /appointments/{apptId} {
      allow create: if isAdmin()
                    || isPatientOrGuardian(request.resource.data.patientId);
      allow read, update: if isAdmin()
                          || isPatientOrGuardian(resource.data.patientId)
                          || (isSignedIn() && resource.data.doctorId == request.auth.uid);
      allow delete: if isAdmin();
    }

    // Reports
    match /reports/{reportId} {
      allow create: if isSignedIn()
                    && request.resource.data.doctorId == request.auth.uid;

      allow read: if isAdmin()
                  || (isSignedIn() && resource.data.patientId == request.auth.uid)
                  || (isSignedIn()
                      && exists(/databases/$(database)/documents/patients/$(resource.data.patientId)/guardians/$(request.auth.uid)))
                  || (isSignedIn() && resource.data.doctorId == request.auth.uid);

      allow update: if (isSignedIn() && resource.data.doctorId == request.auth.uid) || isAdmin();
      allow delete: if isAdmin();
    }
  }
}
